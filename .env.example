// Run: npm install express cors dotenv @google/generative-ai
const express = require('express');
const cors = require('cors');
const { GoogleGenerativeAI } = require("@google/generative-ai");
require('dotenv').config();

const app = express();
app.use(cors());
app.use(express.json());

// MASTER PRODUCT DATABASE
const vaultProducts = [
    { id: 1, name: "ROYAL OYSTER", price: "$45,000", cat: "TIMEPIECE", vid: "vid-watches", img: "https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=600" },
    { id: 2, name: "VELVET TUXEDO", price: "$4,500", cat: "SARTORIAL", vid: "vid-apparel", img: "https://images.unsplash.com/photo-1593030761757-71bd90dbe3a4?w=600" },
    { id: 3, name: "CUBAN LINK 18K", price: "$18,000", cat: "ARTIFACTS", vid: "vid-hero", img: "https://images.unsplash.com/photo-1573408301185-9146fe634ad0?w=600" }
];

const genAI = new GoogleGenerativeAI(process.env.GEMINI_API_KEY);

// API: Sync Inventory
app.get('/api/products', (req, res) => res.json(vaultProducts));

// API: AI Concierge
app.post('/api/chat', async (req, res) => {
    try {
        const model = genAI.getGenerativeModel({ model: "gemini-1.5-flash" });
        const context = `You are the Al Haroon Concierge. Be elite. Inventory: ${vaultProducts.map(p => p.name).join(", ")}`;
        const result = await model.generateContent(`${context}\nClient: ${req.body.message}`);
        res.json({ reply: result.response.text() });
    } catch (e) { res.status(500).json({ error: "Vault offline" }); }
});

app.listen(3000, () => console.log('Al Haroon Secure Backend Live'));
